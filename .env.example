# Server Configuration
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/ai-tracker-bot
MONGODB_USER=admin
MONGODB_PASSWORD=password

# Twilio SMS Service
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_URL=https://yourdomain.com/api/sms/webhook

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_MAX_RESULTS=10

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=30d

# AI/ML Services
AI_MODEL_ENDPOINT=https://api.openai.com/v1
AI_MODEL_API_KEY=sk-your-api-key
AI_MODEL_TYPE=gpt-4
AI_ENABLED=true

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@ai-tracker-bot.com

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# Location Tracking
LOCATION_UPDATE_INTERVAL=300000
LOCATION_RETENTION_DAYS=90
MAX_LOCATIONS_PER_DEVICE=10000

# Geofencing
GEOFENCE_ENABLED=true
GEOFENCE_RADIUS_METERS=100

# Alerts
ALERT_EMAIL_ENABLED=false
ALERT_SMS_ENABLED=true
ALERT_WEBHOOK_URL=https://yourdomain.com/api/webhooks/alerts

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=365

# File Upload
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=.pdf,.jpg,.png,.jpeg

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Encryption
ENCRYPTION_KEY=your_32_character_encryption_key_here
