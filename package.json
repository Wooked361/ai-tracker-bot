{
  "name": "ai-tracker-bot",
  "version": "1.0.0",
  "description": "AI-powered location tracking bot with SMS integration",
  "main": "server/app.js",
  "type": "module",
  "scripts": {
    "start": "node server/app.js",
    "dev": "nodemon server/app.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "npm run lint && npm run test",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "client": "cd client && npm run dev",
    "docker:build": "docker build -t ai-tracker-bot .",
    "docker:run": "docker run -p 3000:3000 --env-file .env ai-tracker-bot",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "tracker",
    "location",
    "sms",
    "ai",
    "twilio",
    "gps",
    "real-time"
  ],
  "author": "Wooked361",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.0",
    "twilio": "^3.77.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.3",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.0.0",
    "axios": "^1.3.0",
    "socket.io": "^4.6.0",
    "redis": "^4.6.0",
    "winston": "^3.8.0",
    "uuid": "^9.0.0",
    "geolib": "^3.3.3",
    "openai": "^3.2.1",
    "qs": "^6.11.0",
    "crypto-js": "^4.1.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "eslint": "^8.40.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.0",
    "@types/jest": "^29.5.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
